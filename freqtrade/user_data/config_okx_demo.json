{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 2,
  "stake_currency": "USDT",
  "stake_amount": 25,
  "tradable_balance_ratio": 0.5,
  "timeframe": "15m",
  "dry_run": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "liquidation_buffer": 0.1,
  "cancel_open_orders_on_exit": true,
  "unfilledtimeout": {
    "entry": 5,
    "exit": 5,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "okx",
    "api_key": "",
    "secret": "",
    "password": "",
    "ccxt_config": {
      "options": {
        "sandboxMode": true
      },
      "headers": {
        "x-simulated-trading": "1"
      },
      "hostname": "openapi.okx.com",
      "urls": {
        "api": {
          "ws": "wss://wspap.okx.com:8443/ws/v5",
          "rest": "https://openapi.okx.com"
        }
      }
    },
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT"
    ],
    "pair_blacklist": []
