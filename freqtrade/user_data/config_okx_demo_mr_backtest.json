{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 6,
  "stake_currency": "USDT",
  "stake_amount": 25,
  "timeframe": "5m",
  "dry_run": true,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "liquidation_buffer": 0.1,
  "unfilledtimeout": {
    "entry": 3,
    "exit": 3,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": false,
    "price_side_balance": 0.05
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": false,
    "price_side_balance": 0.05
  },
  "exchange": {
    "name": "okx",
    "api_key": "",
    "secret": "",
    "password": "",
    "ccxt_config": {
      "options": {
        "defaultType": "swap",
        "sandboxMode": true
      },
      "headers": {
        "x-simulated-trading": "1"
      },
      "hostname": "openapi.okx.com",
      "urls": {
        "api": {
          "ws": "wss://wspap.okx.com:8443/ws/v5",
          "rest": "https://openapi.okx.com"
        }
      }
    },
    "pair_whitelist": [
      "PEPE/USDT:USDT",
      "CAT/USDT:USDT",
      "DOGE/USDT:USDT",
      "NEAR/USDT:USDT",
      "ACT/USDT:USDT",
      "BOME/USDT:USDT",
      "XRP/USDT:USDT",
      "ETH/USDT:USDT",
      "TRX/USDT:USDT",
      "HBAR/USDT:USDT",
      "ALGO/USDT:USDT",
      "ZAMA/USDT:USDT",
      "BTC/USDT:USDT",
      "SOL/USDT:USDT"
